+
+   if (timed) {
+      int64_t took = os_time_get_nano() - t0;
+      vdrm_account_wait(VDRM_WAIT_BO, took);
+      int64_t slow = u_wait_log_slow_ns();
+      if (slow && took > slow) {
+         char stamp[16];
+         u_wait_log_stamp(stamp);
+         mesa_logw("%s vdrm: bo_wait handle %u took %.1f ms tid %d", stamp, handle,
